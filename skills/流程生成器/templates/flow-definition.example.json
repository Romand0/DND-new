{
  "id": "spell:fireball",
  "name": "火球术",
  "category": "spell",
  "description": "1 动作，60 尺，V，区域，敏捷豁免，未通过受 8d6 火焰伤害，通过受一半（4d6）",
  "tags": ["塑能", "三环", "范围伤害"],
  "script": {
    "hat": {
      "kind": "hat",
      "id": "cast_start",
      "label": "施法开始",
      "config": { "autoChecks": { "components": true, "range": true, "time": true } }
    },
    "body": [
      {
        "kind": "step",
        "nodeType": "select_target",
        "id": "select_target",
        "label": "选择区域",
        "config": { "mode": "area", "maxCount": 10 }
      },
      {
        "kind": "if",
        "nodeType": "saving_throw",
        "id": "save_dex",
        "label": "敏捷豁免",
        "config": { "ability": "dexterity", "dc": "15" },
        "onTrue": [
          {
            "kind": "step",
            "nodeType": "apply_effect",
            "id": "damage_fire",
            "label": "火焰伤害",
            "config": { "effectType": "damage", "value": "8d6", "damageType": "fire" }
          }
        ],
        "onFalse": [
          {
            "kind": "step",
            "nodeType": "apply_effect",
            "id": "damage_half",
            "label": "火焰伤害（减半）",
            "config": { "effectType": "damage", "value": "4d6", "damageType": "fire" }
          }
        ]
      },
      {
        "kind": "step",
        "nodeType": "cast_end",
        "id": "cast_end",
        "label": "施法结束"
      }
    ]
  }
}
