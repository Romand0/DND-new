    "charisma": 10,
    "savingThrows": [],
    "skills": [],
    "senses": "Senses。孢子奴仆具有30尺感官范围的盲视，而在此范围外视为目盲。",
    "languages": "Languages。孢子奴仆失去所有曾经掌握的语言，但它会响应蕈人通过通念孢子发布的命令。发令的蕈人越强其命令优先级越高。",
    "damageResistances": [],
    "damageImmunities": [],
    "damageVulnerabilities": [],
    "conditionImmunities": [],
    "traits": [
      {
        "name": "痛觉孢子Distress Spores",
        "text": "蕈人受到伤害时，其身边240尺内所有其他的蕈人都可以感觉到它的伤痛。"
      },
      {
        "name": "厌日Sun Sickness",
        "text": "在阳光照射下，蕈人的属性检定、攻击检定和豁免检定均具有劣势，蕈人受1小时的阳光直晒将导致其死亡。"
      },
      {
        "name": "多重攻击Multiattack",
        "text": "蕈人可以先使用至幻孢子或安抚孢子，然后再发动拳击攻击。"
      },
      {
        "name": "活化孢子Animating Spores",
        "text": "（3/日）蕈人向身边5尺范围内一具尸体释放孢子，尸体必须是类人生物，或体型为大型或更小体型的野兽。目标尸体将在24小时后成为一只孢子奴仆。生成的孢子奴仆可以持续活动1d4+1周或直至被破坏，此后失去活力的孢子奴仆不可以再以该方式激活。"
      },
      {
        "name": "致幻孢子Hallucination Spores",
        "text": "蕈人向身边5尺范围内一个它能看见的生物发射孢子，该目标必须成功通过一次DC 12的体质豁免否则陷入中毒，其效应持续1分钟。中毒目标因产生幻觉而陷入失能状态。该目标可以在其自己的每一回合结束时再次进行该豁免，豁免成功则终止该效应。"
      },
      {
        "name": "安抚孢子Pacifying Spores",
        "text": "蕈人向身边5尺范围内一个它能看到的生物发射孢子，该目标必须成功通过一次DC 12的体质豁免否则被震慑，其效应持续1分钟。该目标可以在每个其自己的回合结束时再次进行该豁免，豁免成功则终止其身上的该效应。"
      },
      {
        "name": "通念孢子Rapport Spores",
        "text": "蕈人在其周边30尺半径范围内释放孢子。这些孢子可以充满区域内所有的地形角落，并影响其内智力值不低于2的生物，这些生物不能是亡灵、构装生物或元素生物。成功受影响的生物相互间可以在30尺内以心灵感应进行交流。其效应持续1小时。孢子奴仆模版Spore Servant Template任何大型或更小体型的生物都可以通过蕈人王的活化孢子复活，成为一只孢子奴仆。并非由血肉构成的生物（如构装、元素、泥怪、植物以及亡灵）不能转变为孢子奴仆。一只完成该转变的生物，其特征发生如下变化。"
      },
      {
        "name": "保留特征",
        "text": "孢子奴仆保留其护甲等级、生命值、生命骰、力量值、敏捷值、体质值、伤害易伤、抗性以及免疫条目。"
      },
      {
        "name": "损失特征",
        "text": "孢子奴仆失去其原豁免和技能的加值，以及其特殊感官和专有特质。除多重攻击Multiattack和造成钝击、穿刺、挥砍伤害的近战武器攻击动作项外，其他动作项也不再保留。攻击动作项中造成的其他类型额外伤害也将一并失去，除非其伤害来自得到保留的特殊装备（比如某件魔法物品）。"
      },
      {
        "name": "种类Type",
        "text": "孢子奴仆的生物种类为植物，并且失去所有的种类附标"
      },
      {
        "name": "阵营Alignment",
        "text": "孢子奴仆的阵营为无阵营。"
      },
      {
        "name": "速度Speed",
        "text": "所有的孢子奴仆其速度比原速度降低10尺，其结果不低于5尺。"
      },
      {
        "name": "属性值Ability Scores",
        "text": "除保留的三项属性值外。其余能力值变为：智力2（-4），感知6（-2），魅力1（-5）。"
      },
      {
        "name": "感官Senses",
        "text": "孢子奴仆具有30尺感官范围的盲视，而在此范围外视为目盲。"
      },
      {
        "name": "状态免疫Condition Immunities",
        "text": "孢子奴仆免疫致盲、魅惑、恐慌和麻痹。"
      },
      {
        "name": "语言Languages",
        "text": "孢子奴仆失去所有曾经掌握的语言，但它会响应蕈人通过通念孢子发布的命令。发令的蕈人越强其命令优先级越高。"
      },
      {
        "name": "攻击Attacks",
        "text": "如果孢子奴仆失去了所有造成伤害的手段，则它仍可以使用拳头或肢体进行徒手打击。每一击徒手打击造成点钝击伤害等于1d4＋孢子奴仆的力量调整值，当其体型为大型时，则为2d4＋其力量调整值。孢子奴仆范例Sample Spore Servant以下孢子奴仆数据以幽邃熊怪为基础生物。"
      }
