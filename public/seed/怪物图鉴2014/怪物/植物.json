  {
    "templateId": "myconid-sovereign",
    "name": "蕈人王",
    "nameEn": "Myconid Sovereign",
    "cr": "2",
    "xp": 450,
    "proficiencyBonus": 2,
    "pbDerived": true,
    "size": "大型",
    "type": "植物",
    "alignment": "守序中立",
    "ac": 13,
    "acNote": "天生护甲",
    "maxHp": 60,
    "hpDice": "8d10+16",
    "speed": 30,
    "speedNotes": "",
